{
  "name": "arbor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "postinstall": "node ./scripts/fix-node-pty-permissions.mjs",
    "start": "tsx ./index.ts",
    "dev": "tsx watch ./index.ts",
    "ui": "vite --config ui/vite.config.ts ui",
    "build": "vite --config ui/vite.config.ts build ui",
    "build:server": "esbuild index.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --external:node-pty --external:bufferutil --external:utf-8-validate --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "app": "npm run build && npm run build:server && electron .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "esbuild": "^0.24.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@dnd-kit/core": "^6.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.408.0",
    "marked": "^18.0.4",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.21.0"
  }
}
